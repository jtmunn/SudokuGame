<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Maui.Controls.DifficultySelectionPopup"
             IsVisible="False">
    
    <!-- Semi-transparent overlay -->
    <Grid BackgroundColor="#80000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        
        <!-- Centered popup card -->
        <Border x:Name="PopupCard"
                x:FieldModifier="private"
                BackgroundColor="{DynamicResource SummaryBackgroundColor}"
                Stroke="{DynamicResource SummaryBorderColor}"
                StrokeThickness="2"
                Padding="30"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="450"
                MaximumWidthRequest="450">
            
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            
            <Border.Shadow>
                <Shadow Brush="{DynamicResource ShadowColor}" 
                        Opacity="0.5" 
                        Radius="12" 
                        Offset="0,4"/>
            </Border.Shadow>
            
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                <!-- Header with close button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Select Difficulty"
                           FontSize="26"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource SummaryTitleColor}" />
                    
                    <Button Grid.Column="1"
                            Text="&#xf00d;"
                            FontFamily="FontAwesome"
                            FontSize="20"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource SummaryLabelColor}"
                            Clicked="OnCloseClicked" />
                </Grid>
                
                <!-- Difficulty cards -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12">
                        <!-- Easy -->
                        <Border x:Name="EasyCard"
                                x:FieldModifier="private"
                                BackgroundColor="{DynamicResource CellDefaultColor}"
                                Stroke="{DynamicResource GridBorderColor}"
                                StrokeThickness="1"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEasyTapped" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="&#xf11a;"
                                       FontFamily="FontAwesome"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="#4CAF50" />
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Easy"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextColor}" />
                                    <Label x:Name="EasyBestTime"
                                           x:FieldModifier="private"
                                           FontSize="13"
                                           TextColor="{DynamicResource SummaryLabelColor}"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="2"
                                        x:Name="EasyLastPlayedBadge"
                                        x:FieldModifier="private"
                                        BackgroundColor="{DynamicResource SuccessButtonColor}"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="Last Played"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ButtonTextColor}" />
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Medium -->
                        <Border x:Name="MediumCard"
                                x:FieldModifier="private"
                                BackgroundColor="{DynamicResource CellDefaultColor}"
                                Stroke="{DynamicResource GridBorderColor}"
                                StrokeThickness="1"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMediumTapped" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="&#xf4fc;"
                                       FontFamily="FontAwesome"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="#2196F3" />
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Medium"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextColor}" />
                                    <Label x:Name="MediumBestTime"
                                           x:FieldModifier="private"
                                           FontSize="13"
                                           TextColor="{DynamicResource SummaryLabelColor}"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="2"
                                        x:Name="MediumLastPlayedBadge"
                                        x:FieldModifier="private"
                                        BackgroundColor="{DynamicResource SuccessButtonColor}"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="Last Played"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ButtonTextColor}" />
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Hard -->
                        <Border x:Name="HardCard"
                                x:FieldModifier="private"
                                BackgroundColor="{DynamicResource CellDefaultColor}"
                                Stroke="{DynamicResource GridBorderColor}"
                                StrokeThickness="1"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHardTapped" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="&#xf06d;"
                                       FontFamily="FontAwesome"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="#FF9800" />
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Hard"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextColor}" />
                                    <Label x:Name="HardBestTime"
                                           x:FieldModifier="private"
                                           FontSize="13"
                                           TextColor="{DynamicResource SummaryLabelColor}"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="2"
                                        x:Name="HardLastPlayedBadge"
                                        x:FieldModifier="private"
                                        BackgroundColor="{DynamicResource SuccessButtonColor}"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="Last Played"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ButtonTextColor}" />
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Expert -->
                        <Border x:Name="ExpertCard"
                                x:FieldModifier="private"
                                BackgroundColor="{DynamicResource CellDefaultColor}"
                                Stroke="{DynamicResource GridBorderColor}"
                                StrokeThickness="1"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExpertTapped" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="&#xf0e7;"
                                       FontFamily="FontAwesome"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="#F44336" />
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Expert"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextColor}" />
                                    <Label x:Name="ExpertBestTime"
                                           x:FieldModifier="private"
                                           FontSize="13"
                                           TextColor="{DynamicResource SummaryLabelColor}"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="2"
                                        x:Name="ExpertLastPlayedBadge"
                                        x:FieldModifier="private"
                                        BackgroundColor="{DynamicResource SuccessButtonColor}"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="Last Played"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ButtonTextColor}" />
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Evil -->
                        <Border x:Name="EvilCard"
                                x:FieldModifier="private"
                                BackgroundColor="{DynamicResource CellDefaultColor}"
                                Stroke="{DynamicResource GridBorderColor}"
                                StrokeThickness="1"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEvilTapped" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="&#xf6fc;"
                                       FontFamily="FontAwesome"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="#9C27B0" />
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Evil"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextColor}" />
                                    <Label x:Name="EvilBestTime"
                                           x:FieldModifier="private"
                                           FontSize="13"
                                           TextColor="{DynamicResource SummaryLabelColor}"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="2"
                                        x:Name="EvilLastPlayedBadge"
                                        x:FieldModifier="private"
                                        BackgroundColor="{DynamicResource SuccessButtonColor}"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="Last Played"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ButtonTextColor}" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
