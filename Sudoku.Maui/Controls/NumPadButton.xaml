<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Maui.Controls.NumPadButton"
             x:Name="Root">
    
    <!-- Main Circle Button -->
    <Border x:Name="ButtonBorder"
            x:FieldModifier="private"
            BackgroundColor="{DynamicResource PrimaryButtonColor}"
            Stroke="{DynamicResource PrimaryButtonColor}"
            StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="999" />
        </Border.StrokeShape>
        
        <Border.Shadow>
            <Shadow Brush="{DynamicResource ShadowColor}" 
                    Opacity="{DynamicResource ShadowOpacity}" 
                    Radius="6" 
                    Offset="3,3"/>
        </Border.Shadow>
        
        <Grid>
            <!-- Main Number - Centered -->
            <Label x:Name="NumberLabel"
                   x:FieldModifier="private"
                   Text="{Binding Number, Source={x:Reference Root}}"
                   TextColor="{DynamicResource ButtonTextColor}"
                   FontSize="{Binding MainFontSize, Source={x:Reference Root}}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            
            <!-- Count - Top Right (scaled margin) - Always visible -->
            <Label x:Name="CountLabel"
                   x:FieldModifier="private"
                   Text="{Binding RemainingCount, Source={x:Reference Root}}"
                   TextColor="{DynamicResource ButtonTextColor}"
                   FontSize="{Binding CountFontSize, Source={x:Reference Root}}"
                   HorizontalOptions="End"
                   VerticalOptions="Start"
                   Margin="{Binding CountMargin, Source={x:Reference Root}}"
                   IsVisible="True" />
        </Grid>
        
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
