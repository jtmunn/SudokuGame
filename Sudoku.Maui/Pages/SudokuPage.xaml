<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sudoku.Maui"
             xmlns:controls="clr-namespace:Sudoku.Maui.Controls"
             x:Class="Sudoku.Maui.Pages.SudokuPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="80"/>
            <Setter Property="HeightRequest" Value="80"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontFamily" Value="FontAwesome"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonHoverColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonPressedColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="80"/>
            <Setter Property="HeightRequest" Value="80"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButtonColor}"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Shadow">
                <Shadow Brush="{DynamicResource ShadowColor}" 
                        Opacity="{DynamicResource ShadowOpacity}" 
                        Radius="6" 
                        Offset="3,3"/>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButtonColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButtonHoverColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButtonPressedColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontFamily" Value="FontAwesome"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1.0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.7"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.5"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <x:String x:Key="IconLightbulb">&#xf0eb;</x:String>
        <x:String x:Key="IconCheck">&#xf00c;</x:String>
    </ContentPage.Resources>

    <Grid>
        <!-- Main Game Content -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="0" BackgroundColor="{DynamicResource PageBackgroundColor}">
        
            <!-- Header Bar -->
            <Grid Grid.Row="0" 
                  ColumnDefinitions="Auto,*,Auto" 
                  Padding="16,8" 
                  HeightRequest="56"
                  BackgroundColor="{DynamicResource PrimaryButtonColor}">
                
                <!-- Left: Difficulty Level -->
                <Label Grid.Column="0" 
                       x:Name="DifficultyLabel"
                       Text="{Binding CurrentDifficulty, StringFormat='Difficulty: {0}'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource ButtonTextColor}"
                       Margin="0,0,20,0"/>
                
                <!-- Center: Timer -->
                <Label Grid.Column="1" 
                       x:Name="TimerLabel"
                       Text="{Binding TimerText, StringFormat='Time: {0}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource ButtonTextColor}"/>
                
                <!-- Right: Action Buttons -->
                <HorizontalStackLayout Grid.Column="2" 
                                      Spacing="16"
                                      HorizontalOptions="End">
                    <Button x:Name="RestartButton"
                            Text="&#xf01e;"
                            Clicked="OnRestartClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="Restart Game"/>
                    
                    <Button x:Name="NewGameButton"
                            Text="&#xf067;"
                            Clicked="OnNewGameClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="New Game"/>
                    
                    <Button x:Name="SettingsButton"
                            Text="&#xf013;"
                            Clicked="OnSettingsClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="Settings"/>
                </HorizontalStackLayout>
            </Grid>
            
            <!-- Game Area -->
            <AbsoluteLayout Grid.Row="1">
                
                <!-- Centered grid -->
                <Border StrokeThickness="0"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="0"
                        x:Name="GridBorder"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize">
                    
                    <controls:SudokuGridView x:Name="SudokuGridView"
                                             BackgroundColor="{DynamicResource SurfaceColor}" />
                </Border>
                
                <!-- Action Buttons -->
                <VerticalStackLayout x:Name="ActionButtonStack"
                                    Spacing="12"
                                    AbsoluteLayout.LayoutFlags="None">
                    <Button x:Name="HintButton"
                            Text="{StaticResource IconLightbulb}"
                            Clicked="OnHintClicked"
                            Style="{StaticResource ActionButtonStyle}"
                            BorderWidth="0"
                            ToolTipProperties.Text="Get a hint"/>
                    
                    <Button x:Name="CheckButton"
                            Text="{StaticResource IconCheck}"
                            Clicked="OnCheckClicked"
                            Style="{StaticResource ActionButtonStyle}"
                            BorderWidth="0"
                            ToolTipProperties.Text="Check for errors"/>
                </VerticalStackLayout>
            </AbsoluteLayout>

            <!-- Number Pad -->
            <HorizontalStackLayout Grid.Row="2"
                                  Spacing="0" 
                                  HorizontalOptions="Center"
                                  Margin="0,0,0,60"
                                  x:Name="NumberPad">
                <controls:NumPadButton Number="1" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="2" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="3" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="4" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="5" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="6" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="7" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="8" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
                <controls:NumPadButton Number="9" 
                                      WidthRequest="80" 
                                      HeightRequest="80"
                                      Margin="6"
                                      MainFontSize="32"
                                      CountFontSize="10"
                                      Tapped="OnNumPadButtonTapped"/>
            </HorizontalStackLayout>
        </Grid>
    
        <!-- Game Summary Popup (overlays everything when visible) -->
        <controls:GameSummaryPopup x:Name="SummaryPopup"
                                  DoneRequested="OnSummaryDoneRequested"
                                  PlayAgainRequested="OnSummaryPlayAgainRequested" />
        
        <!-- Difficulty Selection Popup (overlays everything when visible) -->
        <controls:DifficultySelectionPopup x:Name="DifficultyPopup"
                                          DifficultySelected="OnDifficultySelected"
                                          Dismissed="OnDifficultyPopupDismissed" />
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="1000">
            <VerticalStackLayout HorizontalOptions="Center" 
                                VerticalOptions="Center"
                                Spacing="20">
                <ActivityIndicator IsRunning="True"
                                 Color="{DynamicResource Primary}"
                                 WidthRequest="60"
                                 HeightRequest="60"/>
                <Label x:Name="LoadingMessage"
                       Text="Generating puzzle..."
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
