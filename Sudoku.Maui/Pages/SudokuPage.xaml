<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sudoku.Maui"
             xmlns:controls="clr-namespace:Sudoku.Maui.Controls"
             xmlns:helpers="clr-namespace:Sudoku.Maui.Helpers"
             x:Class="Sudoku.Maui.Pages.SudokuPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="80"/>
            <Setter Property="HeightRequest" Value="80"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontFamily" Value="FontAwesome"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonHoverColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonPressedColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontFamily" Value="FontAwesome"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1.0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.7"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.5"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <Style x:Key="ActionTextButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="ContentLayout" Value="Left,8"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonHoverColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessButtonPressedColor}"/>
                                <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        
        <x:String x:Key="IconEraser">&#xf12d;</x:String>
    </ContentPage.Resources>

    <Grid>
        <!-- Main Game Content -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="0" BackgroundColor="{DynamicResource PageBackgroundColor}">
        
            <!-- Header Bar -->
            <Grid Grid.Row="0" 
                  ColumnDefinitions="Auto,*,Auto" 
                  Padding="16,8" 
                  HeightRequest="56"
                  BackgroundColor="{DynamicResource PrimaryButtonColor}">
                
                <!-- Left: Difficulty Level -->
                <Label Grid.Column="0" 
                       x:Name="DifficultyLabel"
                       Text="{Binding CurrentDifficulty, StringFormat='Difficulty: {0}'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource ButtonTextColor}"
                       Margin="0,0,20,0"/>
                
                <!-- Center: Timer -->
                <Label Grid.Column="1" 
                       x:Name="TimerLabel"
                       Text="{Binding TimerText, StringFormat='Time: {0}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource ButtonTextColor}"/>
                
                <!-- Right: Action Buttons -->
                <HorizontalStackLayout Grid.Column="2" 
                                      Spacing="16"
                                      HorizontalOptions="End">
                    <Button x:Name="RestartButton"
                            Text="&#xf01e;"
                            Clicked="OnRestartClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="Restart Game"/>
                    
                    <Button x:Name="NewGameButton"
                            Text="&#xf067;"
                            Clicked="OnNewGameClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="New Game"/>
                    
                    <Button x:Name="SettingsButton"
                            Text="&#xf013;"
                            Clicked="OnSettingsClicked"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTipProperties.Text="Settings"/>
                </HorizontalStackLayout>
            </Grid>
            
            <!-- Game Area -->
            <controls:SquareLayoutControl Grid.Row="1"
                                          x:Name="SquareLayout"
                                          MinimumSquareSize="{x:Static helpers:SudokuLayoutCalculator.MinGridSize}"
                                          Margin="0,10,0,10"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                <Border StrokeThickness="0"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="0"
                        x:Name="GridBorder">
                    <controls:SudokuBoardControl x:Name="SudokuBoardControl"
                                             BackgroundColor="{DynamicResource SurfaceColor}" />
                </Border>
            </controls:SquareLayoutControl>

            <!-- Bottom Bar: Action Buttons + Number Pad -->
            <VerticalStackLayout Grid.Row="2"
                                 HorizontalOptions="Center"
                                 Spacing="0"
                                 Margin="0,10,0,20"
                                 x:Name="BottomBar">
                
                <!-- Row 1: Action Buttons with text labels -->
                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,14"
                                       x:Name="ActionButtonRow">
                    <Button x:Name="HintButton"
                            Text="Hint"
                            Clicked="OnHintClicked"
                            Style="{StaticResource ActionTextButtonStyle}"
                            ToolTipProperties.Text="Get a hint">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="&#xf0eb;"
                                             Size="16"
                                             Color="{DynamicResource ButtonTextColor}"/>
                        </Button.ImageSource>
                    </Button>
                    <Button x:Name="CheckButton"
                            Text="Check"
                            Clicked="OnCheckClicked"
                            Style="{StaticResource ActionTextButtonStyle}"
                            ToolTipProperties.Text="Check for errors">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="&#xf00c;"
                                             Size="16"
                                             Color="{DynamicResource ButtonTextColor}"/>
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
                
                <!-- Row 2: Numbers 1-5 -->
                <HorizontalStackLayout Spacing="0"
                                       HorizontalOptions="Center"
                                       x:Name="NumberPadRow1">
                    <controls:NumberPadButton Number="1" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="2" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="3" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="4" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="5" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                </HorizontalStackLayout>
                
                <!-- Row 3: Numbers 6-9 + Clear -->
                <HorizontalStackLayout Spacing="0"
                                       HorizontalOptions="Center"
                                       x:Name="NumberPadRow2">
                    <controls:NumberPadButton Number="6" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="7" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="8" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <controls:NumberPadButton Number="9" 
                                          WidthRequest="80" HeightRequest="80"
                                          Margin="6" MainFontSize="32" CountFontSize="10"
                                          Tapped="OnNumPadButtonTapped"/>
                    <Button x:Name="ClearButton"
                            Text="{StaticResource IconEraser}"
                            Clicked="OnClearClicked"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="6"
                            BorderWidth="0"
                            ToolTipProperties.Text="Clear selected cell"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    
        <!-- Game Summary Overlay (overlays everything when visible) -->
        <controls:GameSummaryOverlay x:Name="SummaryOverlay"
                                  DoneRequested="OnSummaryDoneRequested"
                                  PlayAgainRequested="OnSummaryPlayAgainRequested" />
        
        <!-- Difficulty Selection Overlay (overlays everything when visible) -->
        <controls:DifficultySelectionOverlay x:Name="DifficultyOverlay"
                                          DifficultySelected="OnDifficultySelected"
                                          Dismissed="OnDifficultyOverlayDismissed" />
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="1000">
            <VerticalStackLayout HorizontalOptions="Center" 
                                VerticalOptions="Center"
                                Spacing="20">
                <ActivityIndicator IsRunning="True"
                                 Color="{DynamicResource Primary}"
                                 WidthRequest="60"
                                 HeightRequest="60"/>
                <Label x:Name="LoadingMessage"
                       Text="Generating puzzle..."
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
