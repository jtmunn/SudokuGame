<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Sudoku.Maui.Resources.Styles.Themes.DarkTheme">

    <!-- Page Colors -->
    <Color x:Key="PageBackgroundColor">#1E1E1E</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="TextColor">#ECF0F1</Color>
    <Color x:Key="SecondaryTextColor">#CCCCCC</Color>
    <Color x:Key="BorderColor">#404040</Color>
    
    <!-- Shell/Navigation Colors -->
    <Color x:Key="ShellBackgroundColor">#2D2D2D</Color>
    <Color x:Key="ShellForegroundColor">#ECF0F1</Color>
    <Color x:Key="ShellTitleColor">#ECF0F1</Color>
    <Color x:Key="ShellUnselectedColor">#7F8C8D</Color>
    
    <!-- Button Colors -->
    <Color x:Key="PrimaryButtonColor">#2980B9</Color>
    <Color x:Key="PrimaryButtonHoverColor">#21618C</Color>
    <Color x:Key="PrimaryButtonPressedColor">#1A5276</Color>
    <Color x:Key="DisabledButtonColor">#4A4A4A</Color>
    <Color x:Key="DisabledButtonTextColor">#666666</Color>
    
    <Color x:Key="SuccessButtonColor">#229954</Color>
    <Color x:Key="SuccessButtonHoverColor">#1E8449</Color>
    <Color x:Key="SuccessButtonPressedColor">#186A3B</Color>
    
    <Color x:Key="ButtonTextColor">White</Color>
    
    <!-- Shadow Colors (no visible shadow for dark theme - set opacity to 0) -->
    <Color x:Key="ShadowColor">#000000</Color>
    <x:Double x:Key="ShadowOpacity">0.0</x:Double>
    
    <!-- Sudoku Grid Colors -->
    <Color x:Key="CellDefaultColor">#383838</Color>
    <Color x:Key="CellGivenColor">#2D2D2D</Color>
    <Color x:Key="CellSelectedColor">#8E44AD</Color>
    <Color x:Key="CellErrorColor">#FF6B6B</Color>
    <Color x:Key="CellHighlightColor">#4A4A4A</Color>
    <Color x:Key="CellLightHighlightColor">#404040</Color>
    <Color x:Key="CellMatchingNumberColor">#5A5A5A</Color>
    
    <Color x:Key="CellUserTextColor">#5DADE2</Color>
    <Color x:Key="CellGivenTextColor">#ECF0F1</Color>
    <Color x:Key="CellErrorTextColor">White</Color>
    
    <Color x:Key="GridBorderColor">#666666</Color>
    <Color x:Key="GridThickBorderColor">#1A4A9E</Color>
    
    <!-- Settings Page Colors -->
    <Color x:Key="SettingsFrameColor">#2D2D2D</Color>
    <Color x:Key="SettingsFrameBorderColor">#404040</Color>
    <Color x:Key="SettingsInputBackgroundColor">#383838</Color>
    <Color x:Key="InfoBackgroundColor">#1B3E20</Color>
    <Color x:Key="InfoBorderColor">#2E5C36</Color>
    <Color x:Key="InfoTextColor">#81C784</Color>
    <Color x:Key="SwitchOnColor">#2980B9</Color>

    <!-- Shell Style -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ShellBackgroundColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ShellTitleColor}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ShellUnselectedColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ShellUnselectedColor}" />
    </Style>

</ResourceDictionary>
